# Anthropic API key — console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Optional but recommended once deployed publicly — set the same value in
# the Zapier "Webhooks by Zapier" step's headers as x-webhook-secret so
# this endpoint can't be called by anyone who finds the URL.
WEBHOOK_SECRET=

PORT=3000
